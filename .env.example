# ── Supabase ─────────────────────────────────────────────────────────────────
# Loyiha: vakil (ref zovvohvvsqzovvmewwyx, eu-central-1).
# Web ilovaga faqat OCHIQ (publishable) kalit kerak — maxfiy (secret/service_role) kalit ishlatilmaydi.
SUPABASE_URL=https://zovvohvvsqzovvmewwyx.supabase.co
SUPABASE_PUBLISHABLE_KEY=

# ── Click ────────────────────────────────────────────────────────────────────
