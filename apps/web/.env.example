# Web ilova (Next.js, statik eksport). Nusxa: .env.example → .env.local
# Bu yerdagi HAMMA qiymat ochiq — build paytida saytga yoziladi. Maxfiy kalit qo'yilmaydi.
# GitHub Pages build'i shu qiymatlarni .github/workflows/deploy-pages.yml dan oladi.

# ── Supabase (himoya — RLS) ──────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://zovvohvvsqzovvmewwyx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ── Sayt pastki yo'lda bo'lsa (GitHub Pages: /<repo>), domen ildizida — bo'sh ──
NEXT_PUBLIC_BASE_PATH=

# ── Click (to'lov havolasi uchun ID'lar; maxfiy emas) ────────────────────────
# Bo'sh bo'lsa "To'lov tizimi hali ulanmagan" chiqadi.
# SECRET_KEY bu yerga EMAS — Supabase Vault'ga (docs/07-dv-mashq.md).
NEXT_PUBLIC_CLICK_SERVICE_ID=
NEXT_PUBLIC_CLICK_MERCHANT_ID=
