# Web ilova (Next.js). Nusxa: .env.example → .env.local (lokal) yoki hosting (Vercel va h.k.) sozlamalariga.

# ── Supabase (ikkalasi ham OCHIQ qiymat; himoya — RLS) ────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://zovvohvvsqzovvmewwyx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ── Sayt manzili (domen ulangach) ─────────────────────────────────────────────
# Click'dan qaytish manzili (return_url) shundan yasaladi. Bo'sh bo'lsa — so'rov Host sarlavhasidan.
# Masalan: https://vakil.uz
NEXT_PUBLIC_SITE_URL=

# ── Click (to'lov havolasi uchun; maxfiy emas) ────────────────────────────────
# Click kabinetidagi raqamlar. Bo'sh bo'lsa "To'lov tizimi hali ulanmagan" chiqadi.
# SECRET_KEY bu yerga EMAS — Supabase Vault'ga (docs/07-dv-mashq.md).
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=

# ── FAQAT LOKAL SINOV (production'da qo'ymang; NODE_ENV=production'da baribir o'chiq) ──
# Google sozlanmagan paytda kirish: Supabase'da email+parolli sinov foydalanuvchisi bo'lishi kerak.
DEV_LOGIN_EMAIL=
DEV_LOGIN_PASSWORD=
# "Sinov to'lovi" tugmasi: Click Prepare/Complete so'rovlarini imzo bilan taqlid qiladi.
# Qiymatlar Vault'dagi click_secret_key / click_service_id bilan BIR XIL bo'lishi kerak.
CLICK_DEV_SECRET=
CLICK_DEV_SERVICE_ID=
